---
import '@fontsource/rajdhani/500.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="A modern, satirical management sim inspired by classic 2000s Flashgames, set in a dense, quirky, and anthropomorphic vision of Hong Kong."
		/>
		<meta
			name="keywords"
			content="A Watt of Trouble, A Watt Of Trouble, management sim, satirical game, 2000s Flashgames, Hong Kong"
		/>
		<meta name="author" content="A Watt of Trouble" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href="https://awattoftrouble.com/" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="A Watt of Trouble" />
		<meta property="og:title" content="A Watt of Trouble" />
		<meta
			property="og:description"
			content="A modern, satirical management sim inspired by classic 2000s Flashgames, set in a dense, quirky, and anthropomorphic vision of Hong Kong."
		/>
		<meta property="og:url" content="https://awattoftrouble.com/" />
		<meta property="og:image" content="https://awattoftrouble.com/bg.png" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="A Watt of Trouble" />
		<meta
			name="twitter:description"
			content="A modern, satirical management sim inspired by classic 2000s Flashgames, set in a dense, quirky, and anthropomorphic vision of Hong Kong."
		/>
		<meta name="twitter:image" content="https://awattoftrouble.com/bg.png" />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'VideoGame',
			name: 'A Watt of Trouble',
			url: 'https://awattoftrouble.com/',
			genre: 'Satirical management simulation',
			description:
				'A modern, satirical management sim inspired by classic 2000s Flashgames, set in a dense, quirky, and anthropomorphic vision of Hong Kong.',
		})} />
		<title>A Watt of Trouble</title>
	</head>
	<body>
		<nav class="navbar" aria-label="Primary navigation">
			<a href="mailto:business@awattoftrouble.com">business@awattoftrouble.com</a>
		</nav>

		<main class="scene" aria-label="Interactive artwork">
			<img class="layer layer-background" src="/bg.png" alt="" aria-hidden="true" />
			<img class="layer layer-foreground" src="/fg.png" alt="" aria-hidden="true" />
		</main>

		<script>
			const scene = document.querySelector('.scene');
			const layers = document.querySelectorAll('.layer');
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

			if (scene && layers.length > 0 && !reduceMotion.matches) {
				let targetX = 0;
				let targetY = 0;
				let currentX = 0;
				let currentY = 0;
				let animationFrame;
				let orientationBaseBeta;
				let orientationBaseGamma;
				let orientationEnabled = false;

				const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

				const updateTarget = (event) => {
					targetX = (event.clientX / window.innerWidth - 0.5) * 2;
					targetY = (event.clientY / window.innerHeight - 0.5) * 2;
				};

				const updateOrientation = (event) => {
					if (event.beta === null || event.gamma === null) return;

					orientationBaseBeta ??= event.beta;
					orientationBaseGamma ??= event.gamma;
					targetX = clamp((event.gamma - orientationBaseGamma) / 8, -1, 1);
					targetY = clamp((event.beta - orientationBaseBeta) / 8, -1, 1);
				};

				const enableOrientation = async () => {
					if (!('DeviceOrientationEvent' in window) || orientationEnabled) return true;

					const orientationEvent = window.DeviceOrientationEvent;
					if (typeof orientationEvent.requestPermission === 'function') {
						try {
							const permission = await orientationEvent.requestPermission();
							if (permission !== 'granted') return false;
						} catch {
							return false;
						}
					}

					window.addEventListener('deviceorientation', updateOrientation, { passive: true });
					orientationEnabled = true;
					return true;
				};

				const animate = () => {
					currentX += (targetX - currentX) * 0.08;
					currentY += (targetY - currentY) * 0.08;

					layers.forEach((layer) => {
						const depth = Number(layer.getAttribute('data-depth') ?? 1);
						layer.style.transform = `translate3d(${currentX * depth}px, ${currentY * depth}px, 0)`;
					});

					animationFrame = requestAnimationFrame(animate);
				};

				scene.addEventListener('pointermove', updateTarget);
				scene.addEventListener('pointerleave', () => {
					targetX = 0;
					targetY = 0;
				});
				const orientationRequiresPermission =
					'DeviceOrientationEvent' in window &&
					typeof window.DeviceOrientationEvent.requestPermission === 'function';

				const retryOrientation = async () => {
					if (await enableOrientation()) {
						window.removeEventListener('pointerdown', retryOrientation);
					}
				};

				enableOrientation();
				if (orientationRequiresPermission) {
					window.addEventListener('pointerdown', retryOrientation, { passive: true });
				}
				layers[0].setAttribute('data-depth', '8');
				layers[1].setAttribute('data-depth', '18');
				animationFrame = requestAnimationFrame(animate);

				window.addEventListener('pagehide', () => {
					cancelAnimationFrame(animationFrame);
				});
			}
		</script>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html),
	:global(body) {
		margin: 0;
		min-width: 100%;
		min-height: 100%;
		overflow: hidden;
		background: #000;
		font-family: 'Rajdhani', sans-serif;
	}

	.navbar {
		position: fixed;
		top: 0;
		left: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 4rem;
		background: rgb(0 0 0 / 28%);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
	}

	.navbar a {
		color: #b08a32;
		font-size: 1.05rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		line-height: 1;
		text-decoration: none;
		transition: color 180ms ease;
	}

	.navbar a:hover,
	.navbar a:focus-visible {
		color: #d0aa4b;
	}

	.scene {
		position: relative;
		width: 100vw;
		height: 100svh;
		overflow: hidden;
		isolation: isolate;
	}

	.layer {
		position: absolute;
		inset: -7.5%;
		width: 115%;
		height: 115%;
		max-width: none;
		object-fit: cover;
		object-position: center;
		user-select: none;
		pointer-events: none;
		will-change: transform;
	}

	.layer-background {
		z-index: 0;
	}

	.layer-foreground {
		z-index: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.layer {
			transform: none !important;
		}
	}
</style>
